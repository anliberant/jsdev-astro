---
import { Check, Copy } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items } = Astro.props;
---

<section class='checklist' data-checklist>
  <h3 class='checklist-title'>{title}</h3>

  <div class='checklist-summary'>
    <p>{description}</p>
    <strong aria-live='polite'>
      <span data-completed>0</span>/{items.length}
    </strong>
  </div>

  <div
    class='checklist-progress'
    role='progressbar'
    aria-label='Checklist progress'
    aria-valuemin='0'
    aria-valuemax={items.length}
    aria-valuenow='0'
    data-progress
  >
    <span data-progress-bar></span>
  </div>

  <ul class='checklist-items'>
    {
      items.map(item => (
        <li>
          <label>
            <input type='checkbox' data-checklist-item />
            <span class='checklist-control' aria-hidden='true'>
              <Check size={16} stroke-width={3} />
            </span>
            <span>{item}</span>
          </label>
        </li>
      ))
    }
  </ul>

  <button type='button' class='checklist-copy' data-copy-checklist>
    <Copy size={18} aria-hidden='true' />
    <span data-copy-label>Copy checklist</span>
  </button>
</section>

<script>
  const initializeChecklist = (checklist: HTMLElement) => {
    const inputs = Array.from(
      checklist.querySelectorAll<HTMLInputElement>('[data-checklist-item]')
    );
    const completed = checklist.querySelector<HTMLElement>('[data-completed]');
    const progress = checklist.querySelector<HTMLElement>('[data-progress]');
    const progressBar = checklist.querySelector<HTMLElement>(
      '[data-progress-bar]'
    );
    const copyButton = checklist.querySelector<HTMLButtonElement>(
      '[data-copy-checklist]'
    );
    const copyLabel = checklist.querySelector<HTMLElement>('[data-copy-label]');

    const updateProgress = () => {
      const checked = inputs.filter(input => input.checked).length;
      const percentage = inputs.length ? (checked / inputs.length) * 100 : 0;

      if (completed) completed.textContent = String(checked);
      if (progressBar) progressBar.style.width = `${percentage}%`;
      progress?.setAttribute('aria-valuenow', String(checked));
    };

    inputs.forEach(input => input.addEventListener('change', updateProgress));

    copyButton?.addEventListener('click', async () => {
      const text = inputs
        .map(input => {
          const label = input.closest('label')?.textContent?.trim() ?? '';
          return `- [${input.checked ? 'x' : ' '}] ${label}`;
        })
        .join('\n');

      try {
        await navigator.clipboard.writeText(text);
        if (copyLabel) copyLabel.textContent = 'Copied';
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy checklist';
        }, 1800);
      } catch {
        if (copyLabel) copyLabel.textContent = 'Copy failed';
      }
    });

    updateProgress();
  };

  document
    .querySelectorAll<HTMLElement>('[data-checklist]')
    .forEach(initializeChecklist);
</script>

<style>
  .checklist {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) * 2);
    background: hsl(var(--card));
    color: hsl(var(--card-foreground));
  }

  .checklist-title {
    margin: 0 0 1.25rem;
    font-family: inherit;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .checklist-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }

  .checklist-summary p {
    margin: 0;
  }

  .checklist-summary strong {
    flex: none;
    color: hsl(var(--foreground));
    font-size: 1rem;
  }

  .checklist-progress {
    height: 0.375rem;
    overflow: hidden;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: hsl(var(--muted));
  }

  .checklist-progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: hsl(var(--primary));
    transition: width 180ms ease;
  }

  .checklist-items {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .checklist-items li {
    margin: 0;
  }

  .checklist-items label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1.5;
  }

  .checklist-items input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  .checklist-control {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    place-items: center;
    margin-top: 0.05rem;
    border: 1px solid hsl(var(--muted-foreground));
    border-radius: 50%;
    color: hsl(var(--primary-foreground));
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .checklist-control :global(svg) {
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .checklist-items input:checked + .checklist-control {
    border-color: hsl(var(--primary));
    background: hsl(var(--primary));
  }

  .checklist-items input:checked + .checklist-control :global(svg) {
    opacity: 1;
  }

  .checklist-items input:focus-visible + .checklist-control {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 3px;
  }

  .checklist-copy {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.875rem;
    transition: background-color 150ms ease;
  }

  .checklist-copy:hover {
    background: hsl(var(--muted));
  }

  .checklist-copy:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .checklist {
      padding: 1rem;
    }

    .checklist-items label {
      font-size: 0.9375rem;
    }
  }
</style>
